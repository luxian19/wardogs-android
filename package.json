{
  "name": "wardogs-android",
  "version": "1.0.0",
  "private": true,
  "description": "WARDOGS 3-Faction Tactical 3D FPS Android app",
  "scripts": {
    "copy:vendor": "node scripts/copy-vendor.mjs",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./www/assets/tailwind.css --minify",
    "build": "npm run copy:vendor && npm run build:css",
    "android:init": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "tailwindcss": "^3.4.17"
  }
}